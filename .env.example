# NexusAI Configuration Template
# Copy this file to .env and insert your API keys

# OpenRouter API Key (Recommended for multi-model LLM access)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI API Key (Optional if using direct OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Base URL override for custom proxies / local LLMs
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
